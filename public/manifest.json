
{
  "manifest_version": 3,
  "name": "Snappy Tool - Screenshot Capture",
  "version": "1.0.1",
  "description": "Captur, crop, copy and download screenshot instantly.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Snapora"
  }
}
